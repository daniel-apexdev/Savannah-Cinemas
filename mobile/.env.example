# Copy to .env and adjust. EXPO_PUBLIC_* values are baked into the app.

# Where the Savannah backend lives. Leave unset in development: the app
# reuses your computer's LAN address (the one Expo shows) on port 5000.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api

# Port of the backend when EXPO_PUBLIC_API_URL is not set.
# EXPO_PUBLIC_API_PORT=5000

# Set to true once paymentController.js talks to a real provider.
# Until then checkout shows a "Test mode" notice.
# EXPO_PUBLIC_PAYMENTS_LIVE=false
