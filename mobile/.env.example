# Copy to .env and fill in. EXPO_PUBLIC_* values are baked into the app,
# so only public values belong here (the publishable key is meant to be public).

# --- Supabase (production and the web version) ----------------------
# Project Settings > API Keys in the Supabase dashboard.
# With these two set, sign-in uses Supabase Auth and the app talks to the
# api Edge Function at <URL>/functions/v1/api.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable key, sb_publishable_...>

# Where the web version lives. Password-reset emails link back here.
EXPO_PUBLIC_SITE_URL=https://daniel-apexdev.github.io/Savannah-Cinemas

# --- Local backend instead (optional) --------------------------------
# Leave the two Supabase lines above unset to use the Node server on your
# computer. The app then reuses your LAN address (the one Expo shows).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
# EXPO_PUBLIC_API_PORT=5000

# Set to true once paymentController.js talks to a real provider.
# Until then checkout shows a "Test mode" notice.
# EXPO_PUBLIC_PAYMENTS_LIVE=false

# Make the website behave like the phone app (sign in before anything).
# Only for testing in a browser; leave unset normally.
# EXPO_PUBLIC_REQUIRE_ACCOUNT=1
